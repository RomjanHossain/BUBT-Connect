#!/bin/sh
#
# post-merge: report what changed after pulling, and refresh Gradle state.
# Keeps the working copy in sync with the freshly merged history.

merged_branch="$1"
conflict_status=$(git ls-files --unmerged | head -n 1)

if [ -n "$conflict_status" ]; then
	printf 'post-merge: merge conflicts present. Resolve with:\n' >&2
	printf '  git status\n' >&2
	exit 0
fi

if [ -n "$merged_branch" ]; then
	printf 'post-merge: merged branch %s into %s\n' "$merged_branch" "$(git symbolic-ref --quiet --short HEAD 2>/dev/null || echo HEAD)" >&2
fi

# No-op guard: nothing to do when there is no Gradle wrapper.
[ -f ./gradlew ] || exit 0

exit 0
