*.jks
*.keystore
*.p12
*.pem
google-services.json
secrets.properties
keystore.properties
signing.properties

# --- IDE ---
.idea/
*.iml
*.iws
*.ipr

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Logs ---
*.log

